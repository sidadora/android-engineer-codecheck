# Android Studio generated files and folders
captures/
*.apk
*.aab

# Gradle files
.gradle/
build/
.kotlin/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# IntelliJ
*.iml
.idea/

# Keystore files
*.jks
*.keystore

# Android Profiling
*.hprof
