<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11以下向け。data_extraction_rules.xmlと同じく、対象とするデータを持たない。 -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
