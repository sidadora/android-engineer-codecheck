<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/repository_search_fragment">

    <fragment
        android:id="@+id/repository_search_fragment"
        android:name="jp.co.yumemi.android.code_check.ui.search.RepositorySearchFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_repository_search">
        <action
            android:id="@+id/action_repository_search_fragment_to_repository_detail_fragment"
            app:destination="@id/repository_detail_fragment" />
    </fragment>

    <fragment
        android:id="@+id/repository_detail_fragment"
        android:name="jp.co.yumemi.android.code_check.ui.detail.RepositoryDetailFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_repository_detail">
        <argument
            android:name="repositoryItem"
            app:argType="jp.co.yumemi.android.code_check.model.RepositoryItem" />
    </fragment>

</navigation>
